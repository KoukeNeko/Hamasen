    "%lld 個書籤已經在清單中，已略過。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld bookmarks are already in the list and were skipped."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld個のブックマークはすでに一覧にあるため省略しました。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個書籤已經在清單中，已略過。"
          }
        }
      }
    },
    "%lld 個檔案不是可辨識的書籤。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld files were not bookmarks this app recognizes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld個のファイルはブックマークとして認識できませんでした。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個檔案不是可辨識的書籤。"
          }
        }
      }
    },
    "%lld 個項目": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld個の項目"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個項目"
          }
        }
      }
    },
    "%lld 台伺服器保留的檔案超過各自的上限。取消保留部分檔案，或把上限調高。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld servers are keeping more on this Mac than their limits allow. Stop keeping some files, or raise the limits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld台のサーバが上限を超えてファイルを保持しています。一部の保持をやめるか、上限を引き上げてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 台伺服器保留的檔案超過各自的上限。取消保留部分檔案，或把上限調高。"
          }
        }
      }
    },
    "%lld 台已經在清單中，已略過。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld were already in the list and were skipped."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld台はすでに一覧にあるため省略しました。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 台已經在清單中，已略過。"
          }
        }
      }
    },
