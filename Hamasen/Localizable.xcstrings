    "備份": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップ"
          }
        },
        "zh-Hant": {
