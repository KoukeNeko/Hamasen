    "%lld 個書籤已經在清單中，已略過。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld bookmarks are already in the list and were skipped."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld個のブックマークはすでに一覧にあるためスキップしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "북마크 %lld개는 이미 목록에 있어 건너뛰었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 个书签已在列表中，已跳过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 個書籤已經在清單中，已略過。"
