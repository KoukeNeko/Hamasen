    "%lld 個檔案不是可辨識的書籤。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld files were not bookmarks this app recognizes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld個のファイルはブックマークとして認識できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 %lld개는 인식할 수 있는 북마크가 아닙니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 个文件不是可识别的书签。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 個檔案不是可辨識的書籤。"
          }
        }
      }
    },
    "%lld 台伺服器保留的檔案超過各自的上限。取消保留部分檔案，或把上限調高。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld servers are keeping more on this Mac than their limits allow. Stop keeping some files, or raise the limits."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld台のサーバが上限を超えてファイルを保持しています。一部の保持をやめるか、上限を引き上げてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버 %lld대가 보관한 파일이 각각의 한도를 초과했습니다. 일부 파일의 보관을 해제하거나 한도를 높이십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 台服务器保留的文件超过各自的上限。取消保留部分文件，或调高上限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 台伺服器保留的檔案超過各自的上限。取消保留部分檔案，或把上限調高。"
          }
        }
      }
    },
