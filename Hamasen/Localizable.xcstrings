        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 기록되지 않았습니다. 처음 연결할 때 서버의 키를 기록하고, 이후 연결할 때마다 이를 대조합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
