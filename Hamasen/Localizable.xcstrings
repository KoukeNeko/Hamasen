    "%@ %@ 已推出" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ is available"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@を利用できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ 출시됨"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ 已发布"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ 已推出"
          }
        }
      }
    },
    "%@ 位於 Finder 側邊欄的「位置」，每組連線是一個資料夾。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ appears under Locations in the Finder sidebar, and each connection is a folder inside it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finderのサイドバーの「場所」の下に%@が表示され、各接続がその中のフォルダになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder 사이드바의 “위치” 아래에 표시되는 %@ 안에서 각 연결이 하나의 폴더입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“访达”边栏的“位置”下方会出现 %@，每个连接是其中一个文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 位於 Finder 側邊欄的「位置」，每組連線是一個資料夾。"
          }
        }
      }
    },
