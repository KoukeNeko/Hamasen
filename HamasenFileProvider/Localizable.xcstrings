{
  "sourceLanguage": "zxx",
  "strings": {
    "%lld 個項目無法釋放本機空間：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not free local space for %1$lld items: %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld個の項目でローカルの空き容量を増やせませんでした：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個項目無法釋放本機空間：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld개 항목의 로컬 공간을 확보하지 못했습니다: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 个项目无法释放本地空间：%2$@"
          }
        }
      }
    },
    "ACTION_COPY_LOCAL_PATH": {
      "comment": "Finder context menu: NSExtensionFileProviderActionName key in Config/HamasenFileProviderInfo.plist",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Local Path"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルパスをコピー"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製本機路徑"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 경로 복사"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝本地路径"
          }
        }
      }
    },
    "ACTION_COPY_REMOTE_PATH": {
      "comment": "Finder context menu: NSExtensionFileProviderActionName key in Config/HamasenFileProviderInfo.plist",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Remote Path"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートパスをコピー"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製遠端路徑"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 경로 복사"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝远程路径"
          }
        }
      }
    },
    "ACTION_FREE_LOCAL_SPACE": {
      "comment": "Finder context menu: NSExtensionFileProviderActionName key in Config/HamasenFileProviderInfo.plist",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free Up Local Space"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの空き容量を増やす"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釋放本機空間"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 공간 확보"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "释放本地空间"
          }
        }
      }
    },
    "ACTION_KEEP_ON_MAC": {
      "comment": "Finder context menu: NSExtensionFileProviderActionName key in Config/HamasenFileProviderInfo.plist",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep on This Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacに保持"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留在這台 Mac"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 보관"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留在这台 Mac"
          }
        }
      }
    },
    "ACTION_REFRESH": {
      "comment": "Finder context menu: NSExtensionFileProviderActionName key in Config/HamasenFileProviderInfo.plist",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新整理"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 고침"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新"
          }
        }
      }
    },
    "ACTION_STOP_KEEPING_ON_MAC": {
      "comment": "Finder context menu: NSExtensionFileProviderActionName key in Config/HamasenFileProviderInfo.plist",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Keeping on This Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacへの保持をやめる"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消保留在這台 Mac"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 보관 해제"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消保留在这台 Mac"
          }
        }
      }
    },
    "ACTION_UNMOUNT_SERVER": {
      "comment": "Finder context menu: NSExtensionFileProviderActionName key in Config/HamasenFileProviderInfo.plist",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unmount Server from Finder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバをFinderからマウント解除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 Finder 卸載此伺服器"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 이 서버 마운트 해제"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“访达”卸载此服务器"
          }
        }
      }
    },
    "DECORATION_PAUSED": {
      "comment": "Label beside a paused server's folder in Finder: NSFileProviderDecorations in Config/HamasenFileProviderInfo.plist",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已暫停"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 정지됨"
          }
        }
      }
    },
    "DECORATION_PINNED": {
      "comment": "Badge label (mouse over, VoiceOver): NSFileProviderDecorations in Config/HamasenFileProviderInfo.plist",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept on This Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacに保持中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留在這台 Mac"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 보관됨"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留在这台 Mac"
          }
        }
      }
    },
    "不支援的動作：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported action: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サポートされていない操作：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援的動作：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되지 않는 동작: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持的操作：%@"
          }
        }
      }
    },
    "只能從伺服器資料夾卸載": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a server folder can be unmounted"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバのフォルダからのみマウント解除できます"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能從伺服器資料夾卸載"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 폴더에서만 마운트 해제할 수 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能从服务器文件夹卸载"
          }
        }
      }
    },
    "無法寫入剪貼簿": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not write to the clipboard"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードに書き込めませんでした"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法寫入剪貼簿"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드에 쓸 수 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法写入剪贴板"
          }
        }
      }
    },
    "這個項目不屬於 Hamasen 掛載": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item is not part of a Hamasen mount"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目はHamasenのマウントに含まれていません"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個項目不屬於 Hamasen 掛載"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 Hamasen 마운트에 속하지 않습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个项目不属于 Hamasen 挂载"
          }
        }
      }
    }
  },
  "version": "1.0"
}
