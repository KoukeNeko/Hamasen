{
  "sourceLanguage": "zxx",
  "strings": {
    "%lld 個項目無法釋放本機空間：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not free local space for %1$lld items: %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld個の項目でローカルの空き容量を増やせませんでした：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個項目無法釋放本機空間：%@"
          }
        }
      }
    },
    "ACTION_COPY_LOCAL_PATH": {
      "comment": "Finder context menu: NSExtensionFileProviderActionName key in Config/HamasenFileProviderInfo.plist",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Local Path"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルパスをコピー"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製本機路徑"
          }
        }
      }
    },
    "ACTION_COPY_REMOTE_PATH": {
      "comment": "Finder context menu: NSExtensionFileProviderActionName key in Config/HamasenFileProviderInfo.plist",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Remote Path"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートパスをコピー"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製遠端路徑"
          }
        }
      }
    },
    "ACTION_FREE_LOCAL_SPACE": {
      "comment": "Finder context menu: NSExtensionFileProviderActionName key in Config/HamasenFileProviderInfo.plist",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free Up Local Space"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの空き容量を増やす"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釋放本機空間"
          }
        }
      }
    },
    "ACTION_KEEP_ON_MAC": {
      "comment": "Finder context menu: NSExtensionFileProviderActionName key in Config/HamasenFileProviderInfo.plist",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep on This Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacに保持"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留在這台 Mac"
          }
        }
      }
    },
    "ACTION_REFRESH": {
      "comment": "Finder context menu: NSExtensionFileProviderActionName key in Config/HamasenFileProviderInfo.plist",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新整理"
          }
        }
      }
    },
    "ACTION_STOP_KEEPING_ON_MAC": {
      "comment": "Finder context menu: NSExtensionFileProviderActionName key in Config/HamasenFileProviderInfo.plist",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Keeping on This Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacへの保持をやめる"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消保留在這台 Mac"
          }
        }
      }
    },
    "ACTION_UNMOUNT_SERVER": {
      "comment": "Finder context menu: NSExtensionFileProviderActionName key in Config/HamasenFileProviderInfo.plist",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unmount Server from Finder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバをFinderから取り出す"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 Finder 卸載此伺服器"
          }
        }
      }
    },
    "不支援的動作：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported action: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サポートされていない操作：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援的動作：%@"
          }
        }
      }
    },
    "只能從伺服器資料夾卸載": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a server folder can be unmounted"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバのフォルダからのみ取り出せます"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能從伺服器資料夾卸載"
          }
        }
      }
    },
    "無法寫入剪貼簿": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not write to the clipboard"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードに書き込めませんでした"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法寫入剪貼簿"
          }
        }
      }
    },
    "這個項目不屬於 Hamasen 掛載": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item is not part of a Hamasen mount"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目はHamasenのマウントに含まれていません"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個項目不屬於 Hamasen 掛載"
          }
        }
      }
    }
  },
  "version": "1.0"
}
