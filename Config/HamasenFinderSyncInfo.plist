<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The FinderSync extension point runs its host with
	     RunLoopType = _NSApplicationMain, so the bundle has to name an
	     application principal class; as a background agent it also stays out
	     of the Dock. -->
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.FinderSync</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).FinderSyncExtension</string>
		<key>NSExtensionAttributes</key>
		<dict/>
	</dict>
</dict>
</plist>
