<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Private keys and bookmarks are read from outside the container, and
	     a configuration backup is written to it; the panels grant neither
	     without this. Read-write rather than a second entry: it covers both.
	     -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>33832Z66QU.group.dev.hamasen.shared</string>
	</array>
	<!-- Where server credentials live, shared with the File Provider
	     extension that connects with them. Granted by the provisioning
	     profile App Store distribution provides. -->
	<key>keychain-access-groups</key>
	<array>
		<string>33832Z66QU.dev.hamasen.credentials</string>
	</array>
</dict>
</plist>
