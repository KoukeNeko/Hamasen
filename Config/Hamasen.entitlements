<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Private keys and Cyberduck bookmarks live outside the container;
	     the open panel only grants access to them with this. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- The legacy "group.*" entry exists only so development builds can
	     migrate old data; scripts/install-devid.sh strips it, because under
	     Developer ID it would demand a provisioning profile. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>33832Z66QU.group.dev.hamasen.shared</string>
		<string>group.dev.hamasen.shared</string>
	</array>
	<!-- Development builds use these only to migrate Data Protection
	     Keychain items. scripts/install-devid.sh strips the restricted
	     entitlement before Developer ID signing. -->
	<key>keychain-access-groups</key>
	<array>
		<string>33832Z66QU.group.dev.hamasen.shared</string>
		<string>33832Z66QU.dev.hamasen.credentials</string>
	</array>
</dict>
</plist>
