<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The extension's icon is what Finder shows next to this provider's
	     context-menu entries and on the mounted folder under CloudStorage.
	     Both keys are needed: the folder in CloudStorage stays a plain folder
	     with CFBundleIconFile alone, which is why Google Drive and Synology
	     Drive declare the primary-icon dictionary as well. -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFile</key>
			<string>AppIcon.icns</string>
		</dict>
	</dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.fileprovider-nonui</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).FileProviderExtension</string>
		<key>NSExtensionFileProviderSupportsEnumeration</key>
		<true/>
		<!-- Required by App Store validation, and it has to name a group
		     this extension's entitlements also list: it is where the system
		     expects the provider and its app to share state, which for
		     Hamasen is the server list, the mounted set, and the pins. -->
		<key>NSExtensionFileProviderDocumentGroup</key>
		<string>33832Z66QU.group.dev.hamasen.shared</string>
		<!-- Finder context menu entries, run through NSFileProviderCustomAction.
		     The system evaluates each rule against `fileproviderItems` (the
		     selection, as indexed items) and `domainUserInfo`; `$item.itemIdentifier`
		     is this provider's own identifier, "srv:<uuid>" for a server's folder
		     and "srv:<uuid>:<path>" inside one (see ItemIdentifierMapper). Names
		     are keys into Localizable.xcstrings. FinderActivationRuleTests pins
		     identifiers and rules to the Swift side. -->
		<key>NSExtensionFileProviderActions</key>
		<array>
			<!-- One item that lives on a server; the Hamasen root has no address. -->
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>dev.hamasen.action.copyRemotePath</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>ACTION_COPY_REMOTE_PATH</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>fileproviderItems.@count == 1 AND SUBQUERY(fileproviderItems, $item, $item.itemIdentifier BEGINSWITH "srv:").@count == 1</string>
			</dict>
			<!-- Every item in the domain, the Hamasen root included, is
			     somewhere under ~/Library/CloudStorage, so this only needs the
			     selection to be a single item. -->
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>dev.hamasen.action.copyLocalPath</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>ACTION_COPY_LOCAL_PATH</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>fileproviderItems.@count == 1</string>
			</dict>
			<!-- Any selection, the Hamasen root included. -->
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>dev.hamasen.action.refresh</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>ACTION_REFRESH</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>fileproviderItems.@count &gt;= 1</string>
			</dict>
			<!-- Exactly one item, and it is a server's own top-level folder. -->
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>dev.hamasen.action.unmountServer</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>ACTION_UNMOUNT_SERVER</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>fileproviderItems.@count == 1 AND SUBQUERY(fileproviderItems, $item, $item.itemIdentifier MATCHES "srv:[0-9A-Fa-f-]{36}(:/)?").@count == 1</string>
			</dict>
			<!-- Offered on files that are not already kept; the item reports
			     the pin in its userInfo, so the pair never both appear. -->
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>dev.hamasen.action.keepOnMac</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>ACTION_KEEP_ON_MAC</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>fileproviderItems.@count &gt;= 1 AND SUBQUERY(fileproviderItems, $item, $item.isFolder == NO AND $item.userInfo.isPinned != YES).@count == fileproviderItems.@count</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>dev.hamasen.action.stopKeepingOnMac</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>ACTION_STOP_KEEPING_ON_MAC</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>fileproviderItems.@count &gt;= 1 AND SUBQUERY(fileproviderItems, $item, $item.userInfo.isPinned == YES).@count == fileproviderItems.@count</string>
			</dict>
			<!-- Something in the selection can hold local content: a folder (its
			     subtree may be downloaded) or a downloaded file. A lone dataless
			     file has nothing to free. -->
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>dev.hamasen.action.freeLocalSpace</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>ACTION_FREE_LOCAL_SPACE</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>SUBQUERY(fileproviderItems, $item, $item.isFolder == YES OR $item.isDownloaded == YES).@count &gt; 0</string>
			</dict>
		</array>
	</dict>
</dict>
</plist>
