<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- hamasen:// links are how the File Provider extension, which cannot
	     show a window, brings the app forward on a connection (see AppLink).
	     Merged with the keys the build generates from INFOPLIST_KEY_*. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.hamasen.mac</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hamasen</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
