#!/bin/sh
# Runs SeaweedFS (master, volume server, filer and S3 gateway in one process)
# and creates the harness's bucket once the cluster takes commands. The
# healthcheck reports healthy only after /tmp/bucket-ready exists.
set -eu

rm -f /tmp/bucket-ready

# -ip=127.0.0.1 keeps the address the master records for itself stable
# across container restarts, whatever address Docker assigns.
# -volume.preStopSeconds=0 drops a 10 s pause from shutdown, which still
# takes about 16 s (stop_grace_period in docker-compose.yml allows for it).
# -volume.max and -master.volumeSizeLimitMB: left alone, the number of volumes
# is worked out from the free disk at 30 GB apiece. On a host with a few GB
# free that leaves none for the bucket's collection, which needs seven at
# once, and every upload fails with InternalError. Volumes are not
# preallocated, and the tests write a few megabytes.
/entrypoint.sh server -ip=127.0.0.1 -ip.bind=0.0.0.0 -volume.preStopSeconds=0 \
    -volume.max=64 -master.volumeSizeLimitMB=1024 \
    -s3 -s3.config=/etc/seaweedfs/s3.json -s3.iam=false &
pid=$!
trap 'kill -TERM "$pid"; wait "$pid"; exit 0' TERM INT

shell() {
    echo "$1" | weed shell -master=127.0.0.1:9333
}
until shell s3.bucket.list | grep -q '^ *hamasen[[:space:]]' \
    || shell 's3.bucket.create -name hamasen'; do
    sleep 1
done
# The gateway takes requests before the volume server has registered its
# volumes with the master; until then a read of an object stored before a
# restart answers 500 InternalError ("volume not found").
until shell volume.list | grep -q 'DataNode '; do
    sleep 1
done
touch /tmp/bucket-ready

wait "$pid"
