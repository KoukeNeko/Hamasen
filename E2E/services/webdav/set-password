#!/bin/sh
# set-password <new>
# rclone reads the htpasswd file when it starts, so a running server is
# restarted. The image build sets the first password before any server runs.
set -eu

hash=$(printf '%s\n' "$1" | openssl passwd -apr1 -stdin)
echo "hamasen:$hash" > /etc/rclone/htpasswd

if [ -f /run/server.pid ]; then
    restart-server
fi
