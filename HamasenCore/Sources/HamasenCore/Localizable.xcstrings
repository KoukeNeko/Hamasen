{
  "sourceLanguage": "zxx",
  "strings": {
    "%@ 不支援 SSH 金鑰認證，請改用密碼": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ does not support SSH key authentication. Use a password instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はSSH鍵認証に対応していません。パスワードをお使いください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서는 SSH 키 인증을 지원하지 않습니다. 암호를 사용하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不支持 SSH 密钥认证，请改用密码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不支援 SSH 金鑰認證，請改用密碼"
          }
        }
      }
    },
    "%@ 失敗（%@）：%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ failed (%2$@): %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@に失敗しました（%2$@）：%3$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 실패(%2$@): %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 失败（%2$@）：%3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 失敗（%@）：%@"
          }
        }
      }
    },
    "%@ 失敗（%@）：沒有權限": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ failed (%2$@): permission denied"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@に失敗しました（%2$@）：権限がありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 실패(%2$@): 권한이 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 失败（%2$@）：没有权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 失敗（%@）：沒有權限"
          }
        }
      }
    },
    "%@ 的主機金鑰和上次不同，連線已中止。可能是伺服器重建過，也可能有人冒充它。核對伺服器端的指紋後，到該伺服器的設定中清除已記錄的金鑰。已記錄：%@，這次收到：%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host key for %1$@ is not the one recorded, so the connection was refused. The server may have been rebuilt, or something may be answering in its place. Check the fingerprint on the server itself, then clear the recorded key in that server’s settings. Recorded: %2$@, received: %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のホスト鍵が記録と異なるため接続を中止しました。サーバが再構築された可能性も、第三者がなりすましている可能性もあります。サーバ側でフィンガープリントを確認してから、そのサーバの設定で記録済みの鍵を消去してください。記録：%2$@、今回：%3$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 호스트 키가 기록된 키와 달라 연결을 중단했습니다. 서버가 재구축되었거나 누군가 서버를 사칭하고 있을 수 있습니다. 서버에서 직접 지문을 확인한 다음 해당 서버의 설정에서 기록된 키를 지우십시오. 기록됨: %2$@, 수신됨: %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的主机密钥与上次不同，连接已中止。可能是服务器重建过，也可能有人冒充它。核对服务器端的指纹后，到该服务器的设置中清除已记录的密钥。已记录：%2$@，这次收到：%3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的主機金鑰和上次不同，連線已中止。可能是伺服器重建過，也可能有人冒充它。核對伺服器端的指紋後，到該伺服器的設定中清除已記錄的金鑰。已記錄：%@，這次收到：%@"
          }
        }
      }
    },
